		.services-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:65px}
		/* ==================== THE OPTYVIBE METHOD SECTION ==================== */
		.nav-anchor{position:relative;top:-90px;visibility:hidden;display:block;height:0}
		#capabilities.method-section{
			background:#dbe7d7;
			color:#131915;
			overflow:hidden;
			padding:105px 0 115px;
			position:relative;
		}
		.method-grid{
			display:grid;
			grid-template-columns:1.05fr 1fr 1.15fr;
			gap:48px;
			align-items:center;
		}
		.method-left{
			min-width:0;
		}
		.method-eyebrow{
			font:11px/1.2 var(--mono);
			letter-spacing:.14em;
			text-transform:uppercase;
			color:#527054;
			margin-bottom:20px;
		}
		.method-headline{
			font-size:clamp(38px,4.2vw,56px);
			font-weight:800;
			line-height:1.06;
			letter-spacing:-.045em;
			color:#131915;
			margin:0 0 24px;
		}
		.method-headline .method-accent{
			color:#2e5831;
			font-style:italic;
			font-weight:800;
		}
		.method-copy{
			color:#48544a;
			line-height:1.65;
			font-size:14.5px;
			max-width:400px;
			margin:0 0 32px;
		}
		.method-tags{
			display:flex;
			flex-wrap:wrap;
			gap:8px 10px;
			max-width:380px;
		}
		.method-tag{
			font:11px/1 var(--mono);
			color:#2d3a2f;
			background:rgba(255,255,255,.32);
			border:1px solid rgba(82,112,84,.28);
			border-radius:8px;
			padding:8px 13px;
			letter-spacing:.02em;
			transition:border-color .2s ease,background .2s ease;
		}
		.method-tag:hover{
			background:rgba(255,255,255,.6);
			border-color:rgba(46,88,49,.5);
		}

		/* Center Editorial Visual */
		.method-center{
			position:relative;
			display:flex;
			justify-content:center;
			align-items:center;
			min-height:430px;
		}
		.method-aura{
			position:absolute;
			width:380px;
			height:380px;
			border-radius:50%;
			background:radial-gradient(circle,rgba(255,255,255,.85) 0%,rgba(215,242,212,.5) 45%,transparent 72%);
			top:50%;
			left:50%;
			transform:translate(-50%,-50%);
			filter:blur(24px);
			pointer-events:none;
			z-index:1;
		}
		.method-card-back{
			position:relative;
			z-index:2;
			width:min(320px,100%);
			height:380px;
			background:#121814;
			border-radius:24px;
			border:1px solid rgba(255,255,255,.08);
			box-shadow:0 24px 50px rgba(18,32,22,.2),0 4px 12px rgba(0,0,0,.08);
			overflow:hidden;
			display:flex;
			flex-direction:column;
			justify-content:space-between;
			padding:28px 24px 22px;
			margin-left:auto;
			margin-right:10px;
		}
		.method-card-back-bg{
			position:absolute;
			inset:0;
			pointer-events:none;
			z-index:1;
		}
		.method-back-svg{
			width:100%;
			height:100%;
			display:block;
			object-fit:cover;
		}
		.method-back-content{
			position:relative;
			z-index:2;
			display:flex;
			flex-direction:column;
			justify-content:space-between;
			height:100%;
		}
		.method-back-words{
			font:12.5px/1.7 var(--mono);
			font-weight:600;
			letter-spacing:.12em;
			color:#e2ede1;
			display:flex;
			flex-direction:column;
		}
		.method-card-dash{
			color:var(--acid);
			font-size:15px;
			margin-top:2px;
		}
		.method-back-brand{
			position:absolute;
			right:0;
			bottom:0;
			text-align:right;
			display:flex;
			flex-direction:column;
			align-items:flex-end;
			z-index:4;
		}
		.method-brand-icon{
			position:relative;
			width:44px;
			height:40px;
			overflow:hidden;
			margin-bottom:4px;
		}
		.method-brand-icon .method-brand-img{
			position:absolute;
			width:220px;
			height:220px;
			max-width:none;
			left:-84px;
			top:-77px;
			display:block;
			filter:drop-shadow(0 0 8px rgba(217,250,98,.3));
		}
		.method-brand-title{
			font:800 13px/1.1 var(--sans);
			letter-spacing:-.02em;
			color:#ffffff;
		}
		.method-brand-sub{
			font:8px/1.2 var(--mono);
			letter-spacing:.08em;
			color:#8ea391;
			margin-top:3px;
		}

		/* Foreground Card */
		.method-card-front{
			position:absolute;
			z-index:3;
			left:0px;
			bottom:15px;
			width:170px;
			height:200px;
			background:#1a231d;
			border-radius:18px;
			border:1px solid rgba(255,255,255,.1);
			box-shadow:0 18px 36px rgba(0,0,0,.32),0 2px 8px rgba(0,0,0,.15);
			overflow:hidden;
			padding:20px 18px;
		}
		.method-card-front-bg{
			position:absolute;
			inset:0;
			pointer-events:none;
			z-index:1;
		}
		.method-front-svg{
			width:100%;
			height:100%;
			display:block;
		}
		.method-front-content{
			position:relative;
			z-index:2;
		}
		.method-front-words{
			font:12px/1.7 var(--mono);
			font-weight:600;
			letter-spacing:.12em;
			color:#e2ede1;
			display:flex;
			flex-direction:column;
		}

		/* Right Process Steps (5 Rows) */
		.method-right{
			min-width:0;
		}
		.method-steps{
			display:flex;
			flex-direction:column;
			gap:18px;
		}
		.method-step{
			display:flex;
			align-items:flex-start;
			gap:16px;
			padding:4px 0;
		}
		.method-icon-tile{
			width:44px;
			height:44px;
			flex-shrink:0;
			border-radius:12px;
			background:rgba(255,255,255,.55);
			border:1px solid rgba(82,112,84,.18);
			display:grid;
			place-items:center;
			box-shadow:0 2px 8px rgba(32,54,34,.05);
			transition:transform .2s ease,background .2s ease;
		}
		.method-step:hover .method-icon-tile{
			transform:scale(1.06);
			background:#ffffff;
			border-color:rgba(46,88,49,.35);
		}
		.method-step-svg{
			width:20px;
			height:20px;
			stroke:#2e5831;
			stroke-width:1.8;
			fill:none;
			stroke-linecap:round;
			stroke-linejoin:round;
		}
		.method-step-body{
			min-width:0;
			padding-top:2px;
		}
		.method-step-header{
			display:flex;
			align-items:baseline;
			gap:12px;
			margin-bottom:4px;
		}
		.method-step-num{
			font:11px/1 var(--mono);
			font-weight:600;
			color:#527054;
			letter-spacing:.04em;
		}
		.method-step-title{
			font:800 15px/1.2 var(--sans);
			letter-spacing:-.02em;
			color:#131915;
			margin:0;
		}
		.method-step-desc{
			font-size:13px;
			line-height:1.45;
			color:#48544a;
			margin:0;
			max-width:340px;
		}

		/* Responsive Adjustments */
		@media(min-width:801px) and (max-width:1150px){
			.method-grid{
				grid-template-columns:1.05fr .95fr 1.05fr;
				gap:24px;
			}
			.method-headline{
				font-size:clamp(32px,3.6vw,42px);
			}
			.method-card-back{
				width:270px;
				height:330px;
				padding:20px 18px;
				margin-right:0;
			}
			.method-card-front{
				left:-10px;
				bottom:10px;
				width:145px;
				height:175px;
				padding:16px 14px;
			}
			.method-aura{
				width:280px;
				height:280px;
			}
			.method-step{
				gap:12px;
			}
			.method-icon-tile{
				width:38px;
				height:38px;
			}
			.method-step-svg{
				width:18px;
				height:18px;
			}
			.method-step-title{
				font-size:14px;
			}
			.method-step-desc{
				font-size:12px;
			}
		}
		@media(max-width:800px){
			#capabilities.method-section{
				padding:72px 0 80px;
			}
			.method-grid{
				grid-template-columns:1fr;
				gap:44px;
			}
			.method-headline{
				font-size:clamp(34px,8.5vw,44px);
			}
			.method-copy{
				max-width:100%;
				margin-bottom:24px;
			}
			.method-tags{
				max-width:100%;
				gap:7px 8px;
			}
			.method-tag{
				font-size:10.5px;
				padding:7px 11px;
			}
			.method-center{
				min-height:360px;
				margin:10px 0;
			}
			.method-aura{
				width:300px;
				height:300px;
			}
			.method-card-back{
				width:280px;
				height:340px;
				margin:0 auto;
				padding:22px 20px 18px;
			}
			.method-card-front{
				left:calc(50% - 145px);
				bottom:5px;
				width:155px;
				height:180px;
				padding:16px 14px;
			}
			.method-steps{
				gap:20px;
			}
			.method-step-desc{
				max-width:100%;
				font-size:12.5px;
			}
		}

		/* ==================== WORK PORTFOLIO SECTION ==================== */
		#work{
			background:#0b0f0e;
			position:relative;
			border-top:1px solid rgba(255,255,255,.06);
		}
		.work-head{
			display:flex;
			justify-content:space-between;
			align-items:flex-end;
			margin-bottom:60px;
			gap:40px;
		}
		.work-grid{
			display:grid;
			grid-template-columns:repeat(12,1fr);
			gap:24px;
		}

