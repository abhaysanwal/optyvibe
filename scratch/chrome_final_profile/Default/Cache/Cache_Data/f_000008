		(function initParticleWave(){
			const canvas=document.getElementById('homeWaveCanvas');
			if(!canvas)return;
			const ctx=canvas.getContext('2d');
			if(!ctx)return;
			const section=document.getElementById('contact');
			if(!section)return;

			let width=0,height=0,dpr=1,animId=null,isVisible=false,time=0,lastTime=0;
			const mediaQuery=window.matchMedia('(prefers-reduced-motion: reduce)');
			let prefersReduced=mediaQuery.matches;

			function resize(){
				const rect=canvas.getBoundingClientRect();
				width=Math.floor(rect.width);
				height=Math.floor(rect.height);
				if(width<=0||height<=0)return;
				dpr=Math.min(window.devicePixelRatio||1,2);
				canvas.width=Math.floor(width*dpr);
				canvas.height=Math.floor(height*dpr);
			}

			function renderFrame(t){
				if(width<=0||height<=0)return;
				ctx.clearRect(0,0,canvas.width,canvas.height);

				const isMobile=width<=800;
				const cols=isMobile?36:64;
				const rows=isMobile?18:26;
				const theta=0.38;
				const cosT=Math.cos(theta);
				const sinT=Math.sin(theta);
				const D=520;
				const F=430;
				const horizonY=height*0.54;
				const zMin=130;
				const zMax=820;
				const xSpan=width*(isMobile?0.75:0.65);

				const grid=[];
				for(let j=0;j<rows;j++){
					const zRatio=j/(rows-1);
					const z=zMin+zRatio*(zMax-zMin);
					const pz=1-zRatio;
					const fadeZ=Math.sin(zRatio*Math.PI);
					const rowPoints=[];

					for(let i=0;i<cols;i++){
						const xRatio=i/(cols-1);
						const x=-xSpan+xRatio*(2*xSpan);
						const fadeX=Math.sin(xRatio*Math.PI);
						const edgeAlpha=Math.pow(fadeX*fadeZ,0.75);

						const w1=Math.sin(x*0.0032+t*0.9)*32;
						const w2=Math.cos(z*0.0046+t*0.7)*28;
						const w3=Math.sin((x*0.0021+z*0.0033)+t*1.1)*22;
						const Y=w1+w2+w3;

						const yRot=Y*cosT-z*sinT;
						const zRot=Y*sinT+z*cosT+D;
						const scale=(F/zRot)*dpr;
						const sx=(width/2)*dpr+x*scale;
						const sy=horizonY*dpr+yRot*scale;
						const normH=Math.max(0,Math.min(1,(Y+70)/140));

						rowPoints.push({sx,sy,pz,edgeAlpha,normH,scale});
					}
					grid.push(rowPoints);
				}

				for(let j=0;j<rows;j++){
					const row=grid[j];
					const zRatio=j/(rows-1);
					const pz=1-zRatio;
					const fadeZ=Math.sin(zRatio*Math.PI);

					ctx.beginPath();
					for(let i=0;i<cols;i++){
						const pt=row[i];
						if(i===0)ctx.moveTo(pt.sx,pt.sy);
						else ctx.lineTo(pt.sx,pt.sy);
					}
					const lineAlpha=(0.03+0.11*pz)*fadeZ;
					ctx.strokeStyle=`rgba(180,205,190,${lineAlpha.toFixed(3)})`;
					ctx.lineWidth=Math.max(0.5,(0.5+0.6*pz)*dpr);
					ctx.stroke();
				}

				for(let j=0;j<rows;j++){
					const row=grid[j];
					for(let i=0;i<cols;i++){
						const pt=row[i];
						if(pt.edgeAlpha<0.01)continue;

						const isCrest=pt.normH>0.68;
						let r,g,b,alpha,ptRadius;

						if(isCrest){
							const crestRatio=(pt.normH-0.68)/0.32;
							r=Math.round(185+(217-185)*crestRatio);
							g=Math.round(205+(250-205)*crestRatio);
							b=Math.round(190+(98-190)*crestRatio);
							alpha=(0.2+0.45*pt.pz*(0.5+0.5*crestRatio))*pt.edgeAlpha;
							ptRadius=(0.9+1.2*pt.pz+0.5*crestRatio)*dpr;

							if(crestRatio>0.6&&pt.edgeAlpha>0.4){
								ctx.beginPath();
								ctx.arc(pt.sx,pt.sy,ptRadius*2.2,0,Math.PI*2);
								ctx.fillStyle=`rgba(217,250,98,${(alpha*0.28).toFixed(3)})`;
								ctx.fill();
							}
						}else{
							r=165;g=185;b=175;
							alpha=(0.1+0.32*pt.pz*(0.5+0.5*pt.normH))*pt.edgeAlpha;
							ptRadius=(0.8+1.0*pt.pz)*dpr;
						}

						ctx.beginPath();
						ctx.arc(pt.sx,pt.sy,ptRadius,0,Math.PI*2);
						ctx.fillStyle=`rgba(${r},${g},${b},${alpha.toFixed(3)})`;
						ctx.fill();
					}
				}
			}

			function loop(now){
				if(!lastTime)lastTime=now;
				const delta=Math.min((now-lastTime)/1000,0.1);
				lastTime=now;
				time+=delta;

				renderFrame(time);

				if(isVisible&&!prefersReduced){
					animId=requestAnimationFrame(loop);
				}else{
					animId=null;
				}
			}

			function start(){
				if(!animId&&!prefersReduced){
					lastTime=0;
					animId=requestAnimationFrame(loop);
				}
			}

			function stop(){
				if(animId){
					cancelAnimationFrame(animId);
					animId=null;
				}
			}

			const observer=new IntersectionObserver(entries=>{
				entries.forEach(entry=>{
					isVisible=entry.isIntersecting;
					if(isVisible){
						resize();
						if(prefersReduced){
							renderFrame(0);
						}else{
							start();
						}
					}else{
						stop();
					}
				});
			},{threshold:0.05});

			observer.observe(section);

			let resizeTimer;
			window.addEventListener('resize',()=>{
				clearTimeout(resizeTimer);
				resizeTimer=setTimeout(()=>{
					resize();
					if(prefersReduced||!isVisible){
						renderFrame(time);
					}
				},150);
			});

			mediaQuery.addEventListener('change',e=>{
				prefersReduced=e.matches;
				if(prefersReduced){
					stop();
					renderFrame(0);
				}else if(isVisible){
					start();
				}
			});

			resize();
			if(prefersReduced)renderFrame(0);
		})();
	</script>
