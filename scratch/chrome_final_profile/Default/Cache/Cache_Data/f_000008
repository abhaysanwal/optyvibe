			background:#0e1311;
			border:1px solid rgba(255,255,255,.08);
			border-radius:18px;
			padding:24px;
			display:flex;
			flex-direction:column;
			position:relative;
			overflow:hidden;
			text-decoration:none;
			color:inherit;
			cursor:pointer;
			transition:transform .32s cubic-bezier(.16,1,.3,1),border-color .28s ease,box-shadow .28s ease;
		}
		.project-card:hover{
			transform:translateY(-4px);
			border-color:rgba(217,250,98,.38);
			box-shadow:0 20px 40px rgba(0,0,0,.5),0 0 24px rgba(217,250,98,.06);
		}
		.project-card:focus-visible{
			outline:2px solid var(--acid);
			outline-offset:3px;
		}

