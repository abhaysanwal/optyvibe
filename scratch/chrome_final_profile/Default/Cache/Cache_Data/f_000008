		.project-card.project-01{
			grid-column:1 / -1;
			padding:28px 28px 26px;
		}
		@media (min-width:960px){
			.project-card.project-01 .project-card-inner{
				display:grid;
				grid-template-columns:1.32fr 0.68fr;
				gap:36px;
				align-items:center;
			}
			.project-card.project-01 .project-preview{
				height:400px;
				margin-bottom:0;
			}
		}

		.project-card.project-02{
			grid-column:span 7;
		}
		.project-card.project-03{
			grid-column:span 5;
		}
		.project-card.project-04{
			grid-column:span 5;
		}
		.project-card.project-05{
			grid-column:span 7;
		}
		.work-single-wrap{
			width:100%;
		}
		.work-more-bar{
			margin-top:38px;
			display:flex;
			justify-content:center;
		}
		.btn-view-more{
			padding:14px 34px;
			font-size:12.5px;
			letter-spacing:.08em;
			font-weight:800;
		}

